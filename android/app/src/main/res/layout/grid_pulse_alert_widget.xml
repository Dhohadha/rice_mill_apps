<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alert_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ViewFlipper
        android:id="@+id/alert_view_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ======================================================== -->
        <!-- CHILD 0: NORMAL STATE (APPLE / SAMSUNG ONE UI LIGHT THEME)-->
        <!-- ======================================================== -->
        <LinearLayout
            android:id="@+id/alert_normal_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_alert_normal"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Header Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Shield Badge -->
                <TextView
                    android:id="@+id/alert_normal_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_badge_alert_normal"
                    android:paddingStart="9dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="3dp"
                    android:text="🛡️ ALL SYSTEMS SECURE"
                    android:textColor="#059669"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <!-- Brand Name -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GRID PULSE"
                        android:textColor="#0F766E"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="• SAFE"
                        android:textColor="#10B981"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Hero Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/alert_normal_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Grid Operating Safely"
                    android:textColor="#0F172A"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/alert_normal_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="All electrical parameters within safety limits"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <!-- Apple Style Capsule Metric Strip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_capsule_metric_apple"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/alert_normal_metrics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚡ 0.0 kW   │   📊 0.0 kVA   │   ✨ PF 0.000"
                        android:textColor="#334155"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- Footer Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/alert_normal_devices_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="● 24/7 Protection Active"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/alert_normal_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Updated: Just now"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />
            </RelativeLayout>
        </LinearLayout>

        <!-- ======================================================== -->
        <!-- CHILD 1: BREACH STATE (EMERGENCY CRIMSON ULTRA POLISH)   -->
        <!-- ======================================================== -->
        <LinearLayout
            android:id="@+id/alert_breach_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_alert_breach"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Header Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/alert_breach_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_badge_alert_breach"
                    android:paddingStart="9dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="3dp"
                    android:text="🚨 CRITICAL BREACH"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="GRID ALERT ⚠️"
                    android:textColor="#FDE047"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
            </RelativeLayout>

            <!-- Hero Breach Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/alert_breach_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ CMD LIMIT EXCEEDED"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/alert_breach_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Demand exceeded maximum safe threshold"
                    android:textColor="#FECACA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <!-- Apple Style Emergency Action Strip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_alert_action_strip"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="OPEN APP &amp; SILENCE ALARM ➔"
                        android:textColor="#FEF08A"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />
                </LinearLayout>
            </LinearLayout>

            <!-- Footer Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="● IMMEDIATE ATTENTION REQUIRED"
                    android:textColor="#FCA5A5"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/alert_breach_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Breach: Just now"
                    android:textColor="#FCA5A5"
                    android:textSize="9sp" />
            </RelativeLayout>
        </LinearLayout>

    </ViewFlipper>

</FrameLayout>
